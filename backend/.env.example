# Copy this file to .env and fill in your own values.
# .env is gitignored and never committed.

# Firebase default project service account
FIREBASE_KEY_PATH=firebase_key.json
FIRESTORE_COLLECTION=stores

# traders-data-live project service account
TRADERS_KEY_PATH=traders_data_live_key.json
TRADERS_COLLECTION=stores

# Optional: override upload/job directories
# UPLOAD_DIR=uploads
# JOBS_DIR=jobs

# Optional: override pipeline directory (only if auto-discovery fails)
# PIPELINE_DIR=D:/sharea elnassim/pipeline

# Optional: override CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
