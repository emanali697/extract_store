# Copy this file to .env and fill in your own values.
# .env is gitignored and never committed.

# Firebase default project service account
FIREBASE_KEY_PATH=firebase_key.json
FIRESTORE_COLLECTION=stores

# Google Cloud APIs used by the pipeline
GCP_PROJECT_ID=store-extract
GCP_LOCATION=us-central1

# traders-data-live project service account
TRADERS_KEY_PATH=traders_data_live_key.json
TRADERS_COLLECTION=stores
TRADERS_PROJECT_ID=traders-data-live
TRADERS_WRITES_ENABLED=false

# Optional: override upload/job directories
# UPLOAD_DIR=uploads
# JOBS_DIR=jobs

# Optional: override pipeline directory (only if auto-discovery fails)
# PIPELINE_DIR=D:/sharea elnassim/pipeline

# Optional: Python interpreter used to run the pipeline.
# The pipeline needs its own packages (opencv-python, google-cloud-vision, etc.).
# If the backend runs in a virtualenv that lacks them, point this at a Python
# executable that has the pipeline dependencies installed.
# PIPELINE_PYTHON=C:/Users/Admin/AppData/Local/Programs/Python/Python312/python.exe

# Optional: override CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
