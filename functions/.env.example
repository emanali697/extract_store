# Cloud Functions environment variables (local dev / deployed)
# Set via: firebase functions:env:set KEY=VALUE

# GCP / Firebase
GCP_PROJECT_ID=store-extract
GCP_LOCATION=us-central1

# Firestore
FIRESTORE_COLLECTION=stores
JOBS_COLLECTION=jobs
TRADERS_COLLECTION=stores
TRADERS_PROJECT_ID=traders-data-live
# Safety switch: keep false until writes to traders-data-live are approved.
TRADERS_WRITES_ENABLED=false

# Cloud Storage
STORAGE_BUCKET=store-extract.appspot.com

# Pub/Sub topic for pipeline trigger
PIPELINE_TOPIC=run-pipeline

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://extract-store.vercel.app

# Pipeline (for local emulator, point to the Python that has opencv/google-cloud-vision)
# On Windows example:
# PIPELINE_PYTHON=C:/Users/Admin/AppData/Local/Programs/Python/Python312/python.exe

# Traders service account (used in Cloud Functions as a secret, not plain env var)
# In production: create this as a Firebase Secret via:
#   firebase functions:secrets:create TRADERS_SERVICE_ACCOUNT_JSON
# For local emulator only, paste the full JSON string:
# TRADERS_SERVICE_ACCOUNT_JSON={...}

# -----------------------------------------------------------------------------
# Local emulator settings (only needed when running firebase emulators:start)
# These are set automatically by the emulator, but shown here for reference.
# -----------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# STORAGE_EMULATOR_HOST=127.0.0.1:9199
# PUBSUB_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# GOOGLE_CLOUD_PROJECT=store-extract
# GCLOUD_PROJECT=store-extract

# Sentry error monitoring (set as Firebase Functions environment values)
SENTRY_DSN=YOUR_SENTRY_DSN_HERE
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=store-extractor@DEPLOY_VERSION
SENTRY_TRACES_SAMPLE_RATE=0.1
