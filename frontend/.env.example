# Frontend environment variables (copy to .env.development or .env.production)

# Backend API URL
# Local development:
VITE_API_BASE_URL=http://localhost:8000

# Production (Render backend example):
# VITE_API_BASE_URL=https://extract-store-backend.onrender.com

# Optional Firebase web config (only needed for client-side Firebase init)
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_STORAGE_BUCKET=...
# VITE_FIREBASE_SENDER_ID=...
# VITE_FIREBASE_APP_ID=...
