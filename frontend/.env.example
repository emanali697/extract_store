# Frontend environment variables (copy to .env.development or .env.production)
#
# HOW TO GET THESE VALUES:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Select project "store-extract"
# 3. Go to Project Settings (gear icon) > General
# 4. Under "Your apps", choose the Web app (or create one: </>)
# 5. Copy the firebaseConfig values into the variables below

# Firebase Functions API URL
# Local emulator:
VITE_API_BASE_URL=http://127.0.0.1:5001/store-extract/us-central1
VITE_TRADERS_WRITES_ENABLED=false

# Production example (replace after first deploy):
# VITE_API_BASE_URL=https://us-central1-store-extract.cloudfunctions.net

# Required Firebase web config (get from Firebase Console > Project Settings > General > Web App)
VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=store-extract.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=store-extract
VITE_FIREBASE_STORAGE_BUCKET=store-extract.firebasestorage.app
VITE_FIREBASE_SENDER_ID=YOUR_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_APP_ID_HERE
# Sentry browser monitoring (Client Keys / DSN in Sentry project settings)
VITE_SENTRY_DSN=YOUR_SENTRY_DSN_HERE
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=store-extractor@LOCAL_VERSION
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
